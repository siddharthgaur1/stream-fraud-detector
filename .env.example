# Copy to .env and adjust if you're running services outside docker-compose
# (docker-compose.yml already sets the backend URLs for the containers).

# --- required -------------------------------------------------------------
# Comma-separated API keys accepted by /score, /stats and /monitoring.
# The app REFUSES TO START if this is unset and ALLOW_UNAUTHENTICATED is not
# "true". Generate one with: openssl rand -hex 24
API_KEYS=

# Local development only. Never set this on anything reachable off localhost.
# ALLOW_UNAUTHENTICATED=true

# --- backends -------------------------------------------------------------
KAFKA_BROKERS=localhost:19092
KAFKA_TOPIC=transactions

REDIS_URL=redis://localhost:6379/0
# Per-user feature keys expire after this long without a transaction. Without
# it, Redis grows with every user_id ever seen and never shrinks.
REDIS_HISTORY_TTL_SEC=7776000

# Local dev creds only. Never reuse these for anything internet-facing.
POSTGRES_DSN=postgresql://fraud:fraud@localhost:5432/fraud

# --- model ----------------------------------------------------------------
MODEL_DIR=./models
MODEL_VERSION=v1
REPORTS_DIR=./reports

# Leave MLFLOW_TRACKING_URI empty to load models/model.joblib. Set it to serve
# whatever is promoted to MODEL_REGISTRY_STAGE instead.
MLFLOW_TRACKING_URI=
MODEL_REGISTRY_NAME=stream-fraud-detector
MODEL_REGISTRY_STAGE=Production

# Fallbacks only. A trained bundle carries its own weight and threshold and
# those win — the drift reference was computed with them.
FRAUD_SCORE_THRESHOLD=0.7
XGB_WEIGHT=0.7

# --- api ------------------------------------------------------------------
# Requests per minute per API key. 0 disables.
RATE_LIMIT_PER_MIN=600

# --- producer -------------------------------------------------------------
PRODUCER_N_USERS=200
PRODUCER_RATE_PER_SEC=5

# --- monitor / alerting ---------------------------------------------------
MONITOR_INTERVAL_SEC=60
# Unset means drift is still detected and logged, but nobody is notified.
SLACK_WEBHOOK_URL=
# Fraction of monitored columns that must drift, for this many consecutive
# windows, before the retrain alert fires. See RUNBOOK.md#when-drift-fires.
DRIFT_SHARE_THRESHOLD=0.5
DRIFT_CONSECUTIVE_WINDOWS=2
